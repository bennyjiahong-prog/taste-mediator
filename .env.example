# Hackathon key from the Qloo form. Server-only.
# Never commit a real value, and never use a NEXT_PUBLIC_ name.
QLOO_API_KEY=

# Optional. A hackathon key only works on this host.
# Production (https://api.qloo.com) and staging (https://staging.api.qloo.com) are refused.
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional. Turns on the AI agent (Vercel AI SDK + OpenRouter). Server-only.
# Without it, Mediate runs the fixed Qloo pipeline and the page says the agent is off.
OPENROUTER_API_KEY=

# Optional. OpenRouter model slug. Defaults to the recommended multi-step tool model below.
# If Vercel currently overrides this with deepseek/deepseek-chat-v3.1, change the
# Vercel value manually and redeploy; editing this example does not change production.
# Any replacement must support tool calling.
# OPENROUTER_MODEL=openai/gpt-4o-mini
